generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ASSOCIATE
  CTO
}

enum IdeaStatus {
  DRAFT
  ASSIGNED
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
}

enum TaskStatus {
  WHITE
  YELLOW
  GREEN
  ORANGE
  COMPLETED
}

model User {
  id            String        @id @default(cuid())
  username      String        @unique
  name          String
  passwordHash  String
  role          Role          @default(ASSOCIATE)
  avatarUrl     String?
  ledIdeas      Idea[]        @relation("IdeaLead")
  createdIdeas  Idea[]        @relation("CreatedIdeas")
  assignedTasks Task[]        @relation("TaskAssignee")
  submissions   Submission[]
  activityLogs  ActivityLog[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Idea {
  id           String        @id @default(cuid())
  title        String
  description  String
  status       IdeaStatus    @default(DRAFT)
  creator      User          @relation("CreatedIdeas", fields: [createdById], references: [id])
  createdById  String
  lead         User?         @relation("IdeaLead", fields: [leadId], references: [id])
  leadId       String?
  tasks        Task[]
  activityLogs ActivityLog[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Task {
  id                String             @id @default(cuid())
  title             String
  description       String?
  status            TaskStatus         @default(WHITE)
  order             Int                @default(0)
  idea              Idea               @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  ideaId            String
  assignee          User?              @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedToId      String?
  parentTask        Task?              @relation("Revisions", fields: [parentTaskId], references: [id])
  parentTaskId      String?
  revisionTasks     Task[]             @relation("Revisions")
  submissions       Submission[]
  statusTransitions StatusTransition[]
  isRevision        Boolean            @default(false)
  revisionNote      String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model Submission {
  id               String    @id @default(cuid())
  task             Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId           String
  user             User      @relation(fields: [userId], references: [id])
  userId           String
  commitRef        String
  repoUrl          String?
  branch           String?
  message          String?

  prUrl            String?
  prOwner          String?
  prRepo           String?
  prNumber         Int?
  prTitle          String?
  prState          String?
  prMerged         Boolean   @default(false)
  prMergeCommitSha String?
  prAuthorLogin    String?
  lastSyncedAt     DateTime?

  createdAt        DateTime  @default(now())

  @@index([prOwner, prRepo, prNumber])
}

model ActivityLog {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  idea      Idea?    @relation(fields: [ideaId], references: [id])
  ideaId    String?
  action    String
  details   Json
  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
}

model StatusTransition {
  id         String     @id @default(cuid())
  task       Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId     String
  fromStatus TaskStatus
  toStatus   TaskStatus
  changedAt  DateTime   @default(now())

  @@index([taskId, changedAt(sort: Desc)])
}
